# Whop company API key. Keep this server-side only.
WHOP_COMPANY_API_KEY=
# Whop business/account ID (starts with biz_).
WHOP_COMPANY_ID=
# Signing secret for the product webhook (starts with ws_).
WHOP_WEBHOOK_SECRET=
# Set to true only when using Whop sandbox credentials.
WHOP_SANDBOX=false
# Protects the scheduled sync endpoint. Generate a long random value.
CRON_SECRET=
# Public canonical URL, e.g. https://felloughapparel.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000